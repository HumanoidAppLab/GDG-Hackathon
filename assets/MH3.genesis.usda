        over "WheelMaterial"
        {
            token outputs:surface.connect = </MH3/Looks/WheelMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                uniform token info:implementationSource = "id"
                color3f inputs:diffuseColor = (0.3, 0.3, 0.3)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "CasterTireMaterial"
        {
            token outputs:surface.connect = </MH3/Looks/CasterTireMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                uniform token info:implementationSource = "id"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    over "left_castor_wheel"
    {
        def Cylinder "Cylinder"
        {
            uniform token axis = "Z"
            double height = 0.03
            rel material:binding = </MH3/Looks/CasterTireMaterial>
            rel material:binding:physics = </MH3/CastorMaterial>
            double radius = 0.0625
            float3 xformOp:scale = (1, 1, 1)
        }
    }

    over "left_wheel"
    {
        def Cylinder "Cylinder"
        {
            uniform token axis = "Z"
            double height = 0.04
            rel material:binding = </MH3/Looks/WheelMaterial>
            rel material:binding:physics = </MH3/DriveWheelMaterial>
            double radius = 0.1
            float3 xformOp:scale = (1, 1, 1)
        }
    }

    over "right_castor_wheel"
    {
        def Cylinder "Cylinder"
        {
            uniform token axis = "Z"
            double height = 0.03
            rel material:binding = </MH3/Looks/CasterTireMaterial>
            rel material:binding:physics = </MH3/CastorMaterial>
            double radius = 0.0625
            float3 xformOp:scale = (1, 1, 1)
        }
    }

    over "right_wheel"
    {
        def Cylinder "Cylinder"
        {
            uniform token axis = "Z"
            double height = 0.04
            rel material:binding = </MH3/Looks/WheelMaterial>
            rel material:binding:physics = </MH3/DriveWheelMaterial>
            double radius = 0.1
            float3 xformOp:scale = (1, 1, 1)
        }
    }


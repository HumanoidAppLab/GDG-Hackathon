#usda 1.0
(
    defaultPrim = "MH3"
    metersPerUnit = 1
    subLayers = [
        @MH3.usd@
    ]
    upAxis = "Z"
)

over "MH3"
{
    def Material "DriveWheelMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.5
        float physics:restitution = 0
        float physics:staticFriction = 1.5
    }

    def Material "CastorMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0
        float physics:restitution = 0
        float physics:staticFriction = 0
    }

    over "joints"
    {
        over "left_castor_joint"
        {
            float physxJoint:jointFriction = 0
        }

        over "left_castor_wheel_joint"
        {
            float physxJoint:jointFriction = 0
        }

        over "right_castor_joint"
        {
            float physxJoint:jointFriction = 0
        }

        over "right_castor_wheel_joint"
        {
            float physxJoint:jointFriction = 0
        }

        over "L_link_6_joint"
        {
            float physics:lowerLimit = -17.188734
            float physics:upperLimit = 17.188734
        }

        over "L_link_7_joint"
        {
            float physics:lowerLimit = -17.188734
            float physics:upperLimit = 17.188734
        }

        over "R_link_6_joint"
        {
            float physics:lowerLimit = -17.188734
            float physics:upperLimit = 17.188734
        }

        over "R_link_7_joint"
        {
            float physics:lowerLimit = -17.188734
            float physics:upperLimit = 17.188734
        }
    }

    over "mobile_base_link"
    {
        over "base_zedx_camera_link"
        {
            over "ZED_X"
            {
                over "base_link"
                {
                    over "ZED_X"
                    {
                        over "Looks"
                        {
                            over "Black"
                            {
                                token outputs:surface.connect = </MH3/mobile_base_link/base_zedx_camera_link/ZED_X/base_link/ZED_X/Looks/Black/Shader.outputs:surface>

                                over "Shader"
                                {
                                    uniform token info:id = "UsdPreviewSurface"
                                    uniform token info:implementationSource = "id"
                                    color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                                    float inputs:metallic = 0.25
                                    float inputs:roughness = 0.35
                                    token outputs:surface
                                }
                            }

                            over "Black_01"
                            {
                                token outputs:surface.connect = </MH3/mobile_base_link/base_zedx_camera_link/ZED_X/base_link/ZED_X/Looks/Black_01/Shader.outputs:surface>

                                over "Shader"
                                {
                                    uniform token info:id = "UsdPreviewSurface"
                                    uniform token info:implementationSource = "id"
                                    color3f inputs:diffuseColor = (0.01, 0.01, 0.01)
                                    float inputs:metallic = 0
                                    float inputs:roughness = 0.45
                                    token outputs:surface
                                }
                            }
                        }
                    }
                }
            }
        }

        over "visuals" (
            instanceable = false
        )
        {
            over "mobile_base_link"
            {
                over "Scene"
                {
                    over "Looks"
                    {
                        over "Wite"
                        {
                            token outputs:surface.connect = </MH3/mobile_base_link/visuals/mobile_base_link/Scene/Looks/Wite/Wite.outputs:surface>

                            over "Wite"
                            {
                                uniform token info:id = "UsdPreviewSurface"
                                uniform token info:implementationSource = "id"
                                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                                float inputs:metallic = 0
                                float inputs:roughness = 0.3
                                token outputs:surface
                            }
                        }

                        over "Blak"
                        {
                            token outputs:surface.connect = </MH3/mobile_base_link/visuals/mobile_base_link/Scene/Looks/Blak/Blak.outputs:surface>

                            over "Blak"
                            {
                                uniform token info:id = "UsdPreviewSurface"
                                uniform token info:implementationSource = "id"
                                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                                float inputs:metallic = 0.1
                                float inputs:roughness = 0.4
                                token outputs:surface
                            }
                        }
                    }
                }
            }

            over "zedx"
            {
                over "node_STL_BINARY_"
                {
                    over "mesh"
                    {
                        rel material:binding = </MH3/Looks/material_333333>
                    }
                }
            }
        }
    }

    over "head_camera_base_frame"
    {
        over "head_zedxm_camera_link"
        {
            over "ZED_XM"
            {
                over "base_link"
                {
                    over "ZED_XM"
                    {
                        over "Looks"
                        {
                            over "Black"
                            {
                                token outputs:surface.connect = </MH3/head_camera_base_frame/head_zedxm_camera_link/ZED_XM/base_link/ZED_XM/Looks/Black/Shader.outputs:surface>

                                over "Shader"
                                {
                                    uniform token info:id = "UsdPreviewSurface"
